---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SocialIcon from "../components/SocialIcon.astro";
import {
  about,
  education,
  experience,
  profile,
  projects,
  skillGroups
} from "../data/portfolio";

const getProjectLinkIcon = (label: string): "github" | "devpost" | null => {
  const normalized = label.toLowerCase();
  if (normalized === "github") return "github";
  if (normalized === "devpost") return "devpost";
  return null;
};
---

<BaseLayout>
  <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-card" aria-label="Profile photo">
        <img src="/images/avatar.jpeg" alt="Portrait of Apurva Aggarwal" />
      </div>
      <div class="hero-copy">
        <p class="eyebrow">{profile.eyebrow}</p>
        <h1 id="hero-title">{profile.title}</h1>
        <p class="hero-summary">{profile.summary}</p>
        <div class="hero-actions">
          <a class="button primary" href="#projects">View Projects</a>
          <a class="button" href={profile.resume} target="_blank" rel="noopener">Resume</a>
        </div>
      </div>
    </section>

    <section id="about" class="section split-section">
      <div>
        <SectionHeader
          eyebrow={about.eyebrow}
          title={about.title}
        />
      </div>
      <ul class="about-list">
        {about.points.map((point) => <li>{point}</li>)}
      </ul>
    </section>

    <section id="experience" class="section">
      <SectionHeader
        eyebrow="Work"
        title="Experience"
        body="Technical and leadership roles across data systems, consulting, student organizations, and residential life."
      />
      <div class="timeline">
        {experience.map((item) => (
          <article class="timeline-item">
            <span>{item.range}</span>
            <div>
              <div class="experience-heading">
                {item.logo && (
                  <img class="experience-logo" src={item.logo} alt={item.logoAlt ?? `${item.org} logo`} />
                )}
                <div>
                  <h3>{item.role}</h3>
                  <p class="org">{item.org}</p>
                </div>
              </div>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="education" class="section">
      <SectionHeader
        eyebrow="Education"
        title="Academic Background"
        body="The academic foundation behind my work in software, data, and business systems."
      />
      <div class="timeline">
        {education.map((item) => (
          <article class="timeline-item">
            <span>{item.range}</span>
            <div>
              <div class="experience-heading">
                {item.logo && (
                  <img class="experience-logo" src={item.logo} alt={item.logoAlt ?? `${item.org} logo`} />
                )}
                <div>
                  <h3>{item.role}</h3>
                  <p class="org">{item.org}</p>
                </div>
              </div>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="projects" class="section projects-section">
      <SectionHeader
        eyebrow="Selected Builds"
        title="Projects"
        body="Selected work across machine learning, backend systems, internal tools, and interactive software."
      />
      <div class="project-list" data-project-list>
        {projects.map((project) => (
          <article class="project-card" data-project-card tabindex="0" aria-expanded="false" aria-controls={`project-details-${project.number}`}>
            <img src={project.image} alt={`${project.title} preview`} />
            <div class="project-content">
              <div class="project-header">
                <span class="project-number">{project.number}</span>
                {project.links && (
                  <div class="project-links">
                    {project.links.map((link) => {
                      const icon = getProjectLinkIcon(link.label);
                      return (
                        <a class="project-link" href={link.href} target="_blank" rel="noopener">
                          {icon && <SocialIcon name={icon} hiddenLabel={false} />}
                          <span>{link.label}</span>
                        </a>
                      );
                    })}
                  </div>
                )}
              </div>
              <div class="project-title-row">
                <h3>{project.title}</h3>
                <ul class="tag-list" aria-label={`${project.title} tech stack`}>
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
              <p class="project-summary">{project.summary}</p>
              <details>
                <summary>More details</summary>
                <div class="case-study" id={`project-details-${project.number}`}>
                  <article>
                    <h4>Problem</h4>
                    <p>{project.problem}</p>
                  </article>
                  <article>
                    <h4>Approach</h4>
                    <p>{project.approach}</p>
                  </article>
                  <article>
                    <h4>Result</h4>
                    <p>{project.result}</p>
                  </article>
                </div>
              </details>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="skills" class="section">
      <SectionHeader
        eyebrow="Skills"
        title="Technical Stack"
        body="Tools and skills grouped by how I use them."
      />
      <div class="skill-list">
        {skillGroups.map((group) => (
          <article class="skill-row">
            <h3>{group.title}</h3>
            <p>{group.skills.join(", ")}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="contact" class="section contact-section">
      <SectionHeader
        eyebrow="Contact"
        title="Let's build something useful."
        body="Reach out about software, data, AI projects, sustainability, internships, or collaborations."
      />
      <form id="contact-form" method="POST" action="https://formspree.io/f/xovygnbr">
        <input type="hidden" name="_subject" value="New message from Apurva's portfolio" />
        <div class="hidden-field">
          <label>Leave this field empty</label>
          <input type="text" name="_gotcha" />
        </div>
        <div class="form-grid">
          <input type="text" name="name" id="name" placeholder="Name" required />
          <input type="email" name="email" id="email" placeholder="Email" required />
        </div>
        <textarea name="message" id="message" placeholder="Message" rows="6" required></textarea>
        <div class="form-actions">
          <button class="button primary" type="submit">Send Message</button>
          <button class="button" type="reset">Reset</button>
        </div>
        <p id="form-status" aria-live="polite"></p>
      </form>
    </section>
  </main>

  <footer class="footer">
    <p>Copyright &copy; 2026 {profile.name}. Built with Astro and deployed on GitHub Pages.</p>
    <div>
      <a class="icon-link" href={profile.social.github} target="_blank" rel="noopener" aria-label="GitHub">
        <SocialIcon name="github" />
      </a>
      <a class="icon-link" href={profile.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
        <SocialIcon name="linkedin" />
      </a>
      <a class="icon-link" href={profile.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
        <SocialIcon name="instagram" />
      </a>
    </div>
  </footer>

  <div class="command-palette" data-command-palette hidden>
    <button class="command-backdrop" type="button" aria-label="Close command palette" data-command-close></button>
    <section class="command-dialog" role="dialog" aria-modal="true" aria-labelledby="command-title">
      <div class="command-heading">
        <h2 id="command-title">Quick navigation</h2>
        <kbd>ESC</kbd>
      </div>
      <nav class="command-list" aria-label="Quick navigation links">
        <a href="#projects" data-command-link><span>Projects</span><kbd>P</kbd></a>
        <a href="#experience" data-command-link><span>Experience</span><kbd>W</kbd></a>
        <a href="#skills" data-command-link><span>Skills</span><kbd>S</kbd></a>
        <a href="#contact" data-command-link><span>Contact</span><kbd>C</kbd></a>
        <a href={profile.resume} target="_blank" rel="noopener" data-command-link><span>Resume</span><kbd>R</kbd></a>
        <a href={profile.social.github} target="_blank" rel="noopener" data-command-link><span>GitHub</span><kbd>G</kbd></a>
      </nav>
    </section>
  </div>

  <script is:inline src="/assets/js/thankyou.js"></script>
  <script>
    const projectList = document.querySelector("[data-project-list]");
    const projectDetails = Array.from(document.querySelectorAll(".project-card details"));
    const projectCards = Array.from(document.querySelectorAll("[data-project-card]"));
    const progress = document.querySelector("[data-scroll-progress]");

    const syncProjectGridState = () => {
      projectList?.classList.toggle(
        "has-open-details",
        projectDetails.some((details) => details.hasAttribute("open"))
      );
    };

    projectDetails.forEach((details) => {
      details.addEventListener("toggle", syncProjectGridState);
    });

    syncProjectGridState();

    const clearProjectFocus = () => {
      projectCards.forEach((card) => card.classList.remove("is-focused"));
    };

    const closeProjectDetails = () => {
      projectDetails.forEach((details) => {
        details.removeAttribute("open");
        details.closest("[data-project-card]")?.setAttribute("aria-expanded", "false");
      });
      clearProjectFocus();
      syncProjectGridState();
    };

    projectCards.forEach((card) => {
      const toggleProjectCard = () => {
        const details = card.querySelector("details");
        if (!(details instanceof HTMLDetailsElement)) return;
        const shouldClose = card.classList.contains("is-focused") && details.open;
        clearProjectFocus();
        details.open = !shouldClose;
        if (!shouldClose) card.classList.add("is-focused");
        card.setAttribute("aria-expanded", String(details.open));
        syncProjectGridState();
      };

      card.addEventListener("click", (event) => {
        const target = event.target;
        if (target instanceof Element && target.closest("a, button")) return;
        if (target instanceof Element && target.closest("summary")) event.preventDefault();
        toggleProjectCard();
      });

      card.addEventListener("keydown", (event) => {
        if (!(event instanceof KeyboardEvent)) return;
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        toggleProjectCard();
      });
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest("[data-project-card]")) return;
      closeProjectDetails();
    });

    let progressFrame = 0;
    const updateScrollProgress = () => {
      if (!(progress instanceof HTMLElement)) return;
      const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
      const percentage = scrollableHeight > 0 ? (window.scrollY / scrollableHeight) * 100 : 0;
      progress.style.transform = `scaleX(${percentage / 100})`;
    };

    updateScrollProgress();
    document.addEventListener("scroll", () => {
      cancelAnimationFrame(progressFrame);
      progressFrame = requestAnimationFrame(updateScrollProgress);
    }, { passive: true });
    window.addEventListener("resize", updateScrollProgress);

    const palette = document.querySelector("[data-command-palette]");
    const paletteClose = document.querySelector("[data-command-close]");
    const paletteLinks = Array.from(document.querySelectorAll("[data-command-link]"));
    const paletteFocusable = [paletteClose, ...paletteLinks].filter(
      (element): element is HTMLElement => element instanceof HTMLElement
    );
    let paletteReturnFocus: HTMLElement | null = null;

    const setPaletteOpen = (isOpen: boolean) => {
      if (!(palette instanceof HTMLElement)) return;
      if (isOpen) paletteReturnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      palette.hidden = !isOpen;
      document.body.classList.toggle("command-open", isOpen);
      if (isOpen && paletteFocusable[0]) paletteFocusable[0].focus();
      if (!isOpen) paletteReturnFocus?.focus();
    };

    document.addEventListener("keydown", (event) => {
      if (event.key === "Tab" && palette instanceof HTMLElement && !palette.hidden) {
        event.preventDefault();
        const currentIndex = paletteFocusable.indexOf(document.activeElement as HTMLElement);
        const nextIndex = (currentIndex + (event.shiftKey ? -1 : 1) + paletteFocusable.length) % paletteFocusable.length;
        paletteFocusable[nextIndex]?.focus();
        return;
      }
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        setPaletteOpen(!(palette instanceof HTMLElement && !palette.hidden));
      }
      if (event.key === "Escape" && palette instanceof HTMLElement && !palette.hidden) {
        setPaletteOpen(false);
      }
    });

    paletteClose?.addEventListener("click", () => setPaletteOpen(false));
    paletteLinks.forEach((link) => link.addEventListener("click", () => setPaletteOpen(false)));
  </script>
</BaseLayout>
