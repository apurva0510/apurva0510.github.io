---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SocialIcon from "../components/SocialIcon.astro";
import {
  about,
  education,
  experience,
  profile,
  projects,
  skillGroups
} from "../data/portfolio";

const getProjectLinkIcon = (label: string): "github" | "devpost" | null => {
  const normalized = label.toLowerCase();
  if (normalized === "github") return "github";
  if (normalized === "devpost") return "devpost";
  return null;
};
---

<BaseLayout>
  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-card" aria-label="Profile photo">
        <Image src="/images/avatar.jpeg" alt="Portrait of Apurva Aggarwal" width={120} height={120} priority decoding="async" />
      </div>
      <div class="hero-copy">
        <div class="hero-heading">
          <p class="eyebrow">{profile.eyebrow}</p>
          <h1 id="hero-title">{profile.title}</h1>
        </div>
        <p class="hero-summary">{profile.summary}</p>
        <div class="hero-actions">
          <a class="button primary" href="#projects">View Projects</a>
          <a class="button" href={profile.resume} target="_blank" rel="noopener">Resume</a>
        </div>
      </div>
      <a class="hero-scroll-cue" href="#about" aria-label="Scroll to About">
        <span aria-hidden="true"></span>
      </a>
    </section>

    <section id="about" class="section split-section">
      <div>
        <SectionHeader
          eyebrow={about.eyebrow}
          title={about.title}
        />
        <div class="about-fact" aria-live="polite">
          <span class="eyebrow">Beyond the work</span>
          <p data-about-fact>Music content creator</p>
        </div>
      </div>
      <ul class="about-list">
        {about.points.map((point) => <li>{point}</li>)}
      </ul>
    </section>

    <section id="experience" class="section">
      <SectionHeader
        eyebrow="Work"
        title="Experience"
        body="Technical and leadership roles across data systems, consulting, student organizations, and residential life."
      />
      <div class="timeline">
        {experience.map((item) => (
          <article class="timeline-item">
            <span>{item.range}</span>
            <div>
              <div class="experience-heading">
                {item.logo && (
                  <Image class="experience-logo" src={item.logo} alt={item.logoAlt ?? `${item.org} logo`} width={36} height={36} loading="lazy" decoding="async" />
                )}
                <div>
                  <h3>{item.role}</h3>
                  <p class="org">{item.org}</p>
                </div>
              </div>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="education" class="section">
      <SectionHeader
        eyebrow="Education"
        title="Academic Background"
        body="The academic foundation behind my work in software, data, and business systems."
      />
      <div class="timeline">
        {education.map((item) => (
          <article class="timeline-item">
            <span>{item.range}</span>
            <div>
              <div class="experience-heading">
                {item.logo && (
                  <Image class="experience-logo" src={item.logo} alt={item.logoAlt ?? `${item.org} logo`} width={36} height={36} loading="lazy" decoding="async" />
                )}
                <div>
                  <h3>{item.role}</h3>
                  <p class="org">{item.org}</p>
                </div>
              </div>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="projects" class="section projects-section">
      <SectionHeader
        eyebrow="Selected Builds"
        title="Projects"
        body="Selected work across machine learning, backend systems, internal tools, and interactive software."
      />
      <div class="project-list" data-project-list>
        {projects.map((project) => (
          <article class="project-card" data-project-card tabindex="0" aria-expanded="false" aria-controls={`project-details-${project.number}`}>
            <Image src={project.image} alt={`${project.title} preview`} width={180} height={140} loading="lazy" decoding="async" />
            <div class="project-content">
              <div class="project-header">
                <span class="project-number">{project.number}</span>
                {project.links && (
                  <div class="project-links">
                    {project.links.map((link) => {
                      const icon = getProjectLinkIcon(link.label);
                      return (
                        <a class="project-link" href={link.href} target="_blank" rel="noopener">
                          {icon && <SocialIcon name={icon} hiddenLabel={false} />}
                          <span>{link.label}</span>
                        </a>
                      );
                    })}
                  </div>
                )}
              </div>
              <div class="project-title-row">
                <h3>{project.title}</h3>
                <ul class="tag-list" aria-label={`${project.title} tech stack`}>
                  {project.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </div>
              <p class="project-summary">{project.summary}</p>
              <a class="project-link case-study-link" href={`/projects/${project.slug}/`}>Read case study <span aria-hidden="true">↗</span></a>
              <details>
                <summary>More details</summary>
                <div class="case-study" id={`project-details-${project.number}`}>
                  <article>
                    <h4>Problem</h4>
                    <p>{project.problem}</p>
                  </article>
                  <article>
                    <h4>Approach</h4>
                    <p>{project.approach}</p>
                  </article>
                  <article>
                    <h4>Result</h4>
                    <p>{project.result}</p>
                  </article>
                </div>
              </details>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="skills" class="section">
      <SectionHeader
        eyebrow="Skills"
        title="Technical Stack"
        body="Tools and skills grouped by how I use them."
      />
      <div class="skill-list">
        {skillGroups.map((group) => (
          <article class="skill-row">
            <h3>{group.title}</h3>
            <p>{group.skills.join(", ")}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="contact" class="section contact-section">
      <SectionHeader
        eyebrow="Contact"
        title="Let's build something useful."
        body="Reach out about software, data, AI projects, sustainability, internships, or collaborations."
      />
      <form id="contact-form" method="POST" action="https://formspree.io/f/xovygnbr">
        <input type="hidden" name="_subject" value="New message from Apurva's portfolio" />
        <div class="hidden-field">
          <label>Leave this field empty</label>
          <input type="text" name="_gotcha" />
        </div>
        <div class="form-grid">
          <label class="sr-only" for="name">Name</label>
          <input type="text" name="name" id="name" placeholder="Name" required />
          <label class="sr-only" for="email">Email</label>
          <input type="email" name="email" id="email" placeholder="Email" required />
        </div>
        <label class="sr-only" for="message">Message</label>
        <textarea name="message" id="message" placeholder="Message" rows="6" required></textarea>
        <div class="form-actions">
          <button class="button primary" type="submit">Send Message</button>
          <button class="button" type="reset">Reset</button>
        </div>
      </form>
      <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
      <div id="contact-confirmation" class="contact-confirmation" role="status" tabindex="-1" hidden>
        <div class="contact-confirmation-line">
          <span class="contact-confirmation-mark" aria-hidden="true">✓</span>
          <p id="contact-confirmation-message">Thanks! Your message is on its way. I’ll get back to you soon.</p>
        </div>
        <button id="send-another-message" class="button" type="button">Send another message</button>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-copy">
      <p>Copyright &copy; 2026 {profile.name}.</p>
      <p class="footer-note">No dark patterns. Just dark mode.</p>
    </div>
    <div>
      <a class="icon-link" href={profile.social.github} target="_blank" rel="noopener" aria-label="GitHub">
        <SocialIcon name="github" />
      </a>
      <a class="icon-link" href={profile.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
        <SocialIcon name="linkedin" />
      </a>
      <a class="icon-link" href={profile.social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
        <SocialIcon name="instagram" />
      </a>
      <a class="icon-link" href={profile.social.twitter} target="_blank" rel="noopener" aria-label="Twitter">
        <SocialIcon name="twitter" />
      </a>
    </div>
  </footer>

  <div class="easter-egg" data-easter-egg role="status" aria-live="polite" hidden></div>

  <script is:inline src="/assets/js/thankyou.js"></script>
  <script>
    const projectList = document.querySelector("[data-project-list]");
    const projectDetails = Array.from(document.querySelectorAll(".project-card details"));
    const projectCards = Array.from(document.querySelectorAll("[data-project-card]"));
    const updateHeroScrollCue = () => {
      document.body.classList.toggle("has-scrolled", window.scrollY > 24);
    };

    const syncProjectGridState = () => {
      projectList?.classList.toggle(
        "has-open-details",
        projectDetails.some((details) => details.hasAttribute("open"))
      );
    };

    projectDetails.forEach((details) => {
      details.addEventListener("toggle", syncProjectGridState);
    });

    syncProjectGridState();

    const clearProjectFocus = () => {
      projectCards.forEach((card) => card.classList.remove("is-focused"));
    };

    const closeProjectDetails = () => {
      projectDetails.forEach((details) => {
        details.removeAttribute("open");
        details.closest("[data-project-card]")?.setAttribute("aria-expanded", "false");
      });
      clearProjectFocus();
      syncProjectGridState();
    };

    projectCards.forEach((card) => {
      const toggleProjectCard = () => {
        const details = card.querySelector("details");
        if (!(details instanceof HTMLDetailsElement)) return;
        const shouldClose = card.classList.contains("is-focused") && details.open;
        clearProjectFocus();
        details.open = !shouldClose;
        if (!shouldClose) card.classList.add("is-focused");
        card.setAttribute("aria-expanded", String(details.open));
        syncProjectGridState();
      };

      card.addEventListener("click", (event) => {
        const target = event.target;
        if (target instanceof Element && target.closest("a, button")) return;
        if (target instanceof Element && target.closest("summary")) event.preventDefault();
        toggleProjectCard();
      });

      card.addEventListener("keydown", (event) => {
        if (!(event instanceof KeyboardEvent)) return;
        if (event.target !== card) return;
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        toggleProjectCard();
      });
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest("[data-project-card]")) return;
      closeProjectDetails();
    });

    updateHeroScrollCue();
    document.addEventListener("scroll", updateHeroScrollCue, { passive: true });

    const aboutFact = document.querySelector("[data-about-fact]");
    const aboutFacts = [
      "Music content creator",
      "Former cross-country runner",
      "Formula 1 fan",
      "Watch collector",
      "Chess player",
      "Trained in taekwondo",
      "Cars enthusiast",
      "Consistent gym training"
    ];
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let aboutFactIndex = 0;

    if (aboutFact instanceof HTMLElement && !prefersReducedMotion) {
      window.setInterval(() => {
        aboutFact.classList.add("is-changing");
        window.setTimeout(() => {
          aboutFactIndex = (aboutFactIndex + 1) % aboutFacts.length;
          aboutFact.textContent = aboutFacts[aboutFactIndex];
          aboutFact.classList.remove("is-changing");
        }, 220);
      }, 4200);
    }

    const easterEgg = document.querySelector("[data-easter-egg]");
    const easterEggMessages: Record<string, string> = {
      coffee: "Coffee compiled.",
      f1: "Lights out. Build fast.",
      watches: "Time well spent.",
      guitar: "String theory.",
      chess: "Checkmate.",
      spartan: "Go Green."
    };
    let typedBuffer = "";
    let easterEggTimeout = 0;

    document.addEventListener("keydown", (event) => {
      const target = event.target;
      if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || event.key.length !== 1) return;
      typedBuffer = `${typedBuffer}${event.key.toLowerCase()}`.slice(-12);

      const matchedPhrase = Object.keys(easterEggMessages).find((phrase) => typedBuffer.endsWith(phrase));
      if (!matchedPhrase || !(easterEgg instanceof HTMLElement)) return;

      window.clearTimeout(easterEggTimeout);
      easterEgg.textContent = easterEggMessages[matchedPhrase];
      easterEgg.hidden = false;
      easterEggTimeout = window.setTimeout(() => {
        easterEgg.hidden = true;
      }, 2200);
      typedBuffer = "";
    });
  </script>
</BaseLayout>
