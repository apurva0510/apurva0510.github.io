---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import ScrollProgress from "../components/ScrollProgress.astro";
import CommandPalette from "../components/CommandPalette.astro";
import { profile } from "../data/portfolio";

const {
  title = `${profile.name} | Software, Data & AI | Michigan State`,
  description = "Apurva Aggarwal builds data products, full-stack platforms, and applied AI tools. Michigan State CS student, former Tesla and EY intern.",
  structuredData = []
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const previewImageUrl = new URL("/images/og-preview.png", Astro.site ?? Astro.url.origin);
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://apaggarwal.com/#person",
  name: profile.name,
  url: "https://apaggarwal.com/",
  image: "https://apaggarwal.com/images/avatar.jpeg",
  description: "Michigan State University computer science student building data products, full-stack platforms, and applied AI tools.",
  affiliation: { "@type": "CollegeOrUniversity", name: "Michigan State University" },
  sameAs: [profile.social.linkedin, profile.social.github, "https://dev.to/apurva0510"]
};
const schemas = [person, ...structuredData];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#161617" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={`${profile.name} | Portfolio`} />
    <meta property="og:image" content={previewImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Apurva Aggarwal, CS and Business at Michigan State University. Data, Software, Operations." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@apurva_0510" />
    <meta name="twitter:creator" content="@apurva_0510" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImageUrl} />
    <meta name="twitter:image:alt" content="Apurva Aggarwal, CS and Business at Michigan State University. Data, Software, Operations." />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="icon" type="image/png" sizes="16x16" href="/logos/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/logos/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/logos/apple-touch-icon.png" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-613YNELN4M"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-613YNELN4M");
    </script>
    {schemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
    ))}
    <title>{title}</title>
  </head>
  <body>
    <ScrollProgress />
    <Navbar />
    <slot />
    <CommandPalette />
  </body>
</html>
